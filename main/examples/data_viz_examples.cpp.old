/**
 * @file data_viz_examples.cpp
 * @brief ตัวอย่างการใช้งาน Data Visualization Widgets (Batch 4)
 * 
 * Widgets ในไฟล์นี้:
 * - LVChart: Line/Bar/Scatter charts
 * - LVMeter: Circular gauges and meters
 * - LVTable: Data tables
 */

#include "../include/LVChart.hpp"
#include "../include/LVMeter.hpp"
#include "../include/LVTable.hpp"
#include "../include/LVLabel.hpp"
#include "../include/LVButton.hpp"
#include "../include/LVSlider.hpp"

/**
 * ตัวอย่างที่ 1: Line Chart
 * กราฟเส้นพื้นฐาน แสดงข้อมูล temperature
 */
void example_chart_line(lv_obj_t* parent)
{
    auto* chart = new LVChart(nullptr);
    chart->setSize(400, 250)->setPos(20, 20);
    
    // Configure chart
    chart->setType(LV_CHART_TYPE_LINE)
         ->setPointCount(12)
         ->setRange(LV_CHART_AXIS_PRIMARY_Y, 0, 100)
         ->setDivLineCount(5, 6);
    
    // Add temperature series
    lv_chart_series_t* ser1 = chart->addSeries(lv_color_hex(0xe74c3c), LV_CHART_AXIS_PRIMARY_Y);
    
    // Temperature data (12 months)
    std::vector<int32_t> temps = {15, 18, 22, 28, 32, 35, 38, 37, 33, 28, 22, 18};
    chart->setSeriesPoints(ser1, temps);
    
    // Title
    auto* title = new LVLabel(nullptr);
    title->setText("Monthly Temperature (°C)")->setPos(120, 0);
}

/**
 * ตัวอย่างที่ 2: Bar Chart
 * กราฟแท่ง แสดงข้อมูล sales
 */
void example_chart_bar(lv_obj_t* parent)
{
    auto* chart = new LVChart(nullptr);
    chart->setSize(400, 250)->setPos(440, 20);
    
    // Configure as bar chart
    chart->setType(LV_CHART_TYPE_BAR)
         ->setPointCount(7)
         ->setRange(LV_CHART_AXIS_PRIMARY_Y, 0, 100)
         ->setDivLineCount(5, 8);
    
    // Sales data (weekly)
    lv_chart_series_t* sales = chart->addSeries(lv_color_hex(0x3498db), LV_CHART_AXIS_PRIMARY_Y);
    std::vector<int32_t> weekly = {45, 62, 58, 73, 68, 82, 90};
    chart->setSeriesPoints(sales, weekly);
    
    // Title
    auto* title = new LVLabel(nullptr);
    title->setText("Weekly Sales")->setPos(580, 0);
}

/**
 * ตัวอย่างที่ 3: Multi-Series Chart
 * กราฟหลาย series เปรียบเทียบข้อมูล
 */
void example_chart_multi_series(lv_obj_t* parent)
{
    auto* chart = new LVChart(nullptr);
    chart->setSize(500, 300)->setPos(860, 20);
    
    chart->setType(LV_CHART_TYPE_LINE)
         ->setPointCount(10)
         ->setRange(LV_CHART_AXIS_PRIMARY_Y, 0, 100)
         ->setDivLineCount(5, 10);
    
    // CPU usage
    lv_chart_series_t* cpu = chart->addSeries(lv_color_hex(0xe74c3c), LV_CHART_AXIS_PRIMARY_Y);
    std::vector<int32_t> cpuData = {20, 35, 45, 50, 48, 52, 60, 58, 55, 50};
    chart->setSeriesPoints(cpu, cpuData);
    
    // Memory usage
    lv_chart_series_t* mem = chart->addSeries(lv_color_hex(0x3498db), LV_CHART_AXIS_PRIMARY_Y);
    std::vector<int32_t> memData = {30, 32, 35, 40, 42, 45, 48, 50, 52, 55};
    chart->setSeriesPoints(mem, memData);
    
    // Disk usage
    lv_chart_series_t* disk = chart->addSeries(lv_color_hex(0x2ecc71), LV_CHART_AXIS_PRIMARY_Y);
    std::vector<int32_t> diskData = {65, 65, 66, 67, 68, 69, 70, 71, 72, 73};
    chart->setSeriesPoints(disk, diskData);
    
    // Title
    auto* title = new LVLabel(nullptr);
    title->setText("System Resources")->setPos(1030, 0);
}

/**
 * ตัวอย่างที่ 4: Live Chart Update
 * กราฟที่อัพเดทแบบ real-time
 */
void example_chart_live_update(lv_obj_t* parent)
{
    auto* chart = new LVChart(nullptr);
    chart->setSize(450, 250)->setPos(20, 340);
    
    chart->setType(LV_CHART_TYPE_LINE)
         ->setPointCount(20)
         ->setRange(LV_CHART_AXIS_PRIMARY_Y, 0, 100)
         ->setDivLineCount(5, 10);
    
    lv_chart_series_t* series = chart->addSeries(lv_color_hex(0xf39c12), LV_CHART_AXIS_PRIMARY_Y);
    
    // Initialize with zeros
    for (int i = 0; i < 20; i++) {
        chart->setNextSeriesValue(series, 0);
    }
    
    // Button to add data
    auto* addBtn = new LVButton(nullptr);
    addBtn->setSize(120, 40)
          ->setPos(185, 600)
          ->setLabel("Add Data")
          ->onClick([chart, series]() {
              static int value = 50;
              value = (value + (rand() % 21 - 10)) % 100;  // Random walk
              if (value < 0) value = 0;
              chart->setNextSeriesValue(series, value);
              chart->refresh();
          });
    
    auto* title = new LVLabel(nullptr);
    title->setText("Live Data (Click to add)")->setPos(130, 320);
}

/**
 * ตัวอย่างที่ 5: Speedometer Meter
 * Meter แบบ speedometer
 */
void example_meter_speedometer(lv_obj_t* parent)
{
    auto* meter = new LVMeter(nullptr);
    meter->setSize(250, 250)->setPos(500, 340);
    
    // Add scale
    lv_meter_scale_t* scale = meter->addScale();
    meter->setScaleRange(scale, 0, 100, 270, 135)
         ->setScaleTicks(scale, 51, 2, 10, lv_color_hex(0x888888))
         ->setScaleMajorTicks(scale, 10, 4, 15, lv_color_black(), 10);
    
    // Add needle
    lv_meter_indicator_t* needle = meter->addNeedleLine(scale, 4, lv_color_hex(0xe74c3c), -10);
    
    // Add arc indicator
    lv_meter_indicator_t* arc = meter->addArc(scale, 8, lv_color_hex(0x3498db), 0);
    meter->setIndicatorStartValue(arc, 0);
    meter->setIndicatorEndValue(arc, 60);
    
    // Set initial value
    meter->setIndicatorValue(needle, 60);
    
    // Control slider
    auto* speedSlider = new LVSlider(nullptr);
    speedSlider->setSize(230, 20)
               ->setPos(510, 600)
               ->setRange(0, 100)
               ->setValue(60)
               ->onChange([meter, needle, arc](int32_t val) {
                   meter->setIndicatorValue(needle, val);
                   meter->setIndicatorEndValue(arc, val);
               });
    
    auto* title = new LVLabel(nullptr);
    title->setText("Speedometer")->setPos(580, 320);
}

/**
 * ตัวอย่างที่ 6: Multi-Gauge Dashboard
 * Dashboard หลาย gauges
 */
void example_meter_dashboard(lv_obj_t* parent)
{
    // Temperature gauge
    auto* tempMeter = new LVMeter(nullptr);
    tempMeter->setSize(180, 180)->setPos(780, 360);
    
    lv_meter_scale_t* tempScale = tempMeter->addScale();
    tempMeter->setScaleRange(tempScale, 0, 50, 240, 150)
             ->setScaleTicks(tempScale, 26, 2, 8, lv_color_hex(0x888888))
             ->setScaleMajorTicks(tempScale, 5, 3, 12, lv_color_black(), 8);
    
    lv_meter_indicator_t* tempNeedle = tempMeter->addNeedleLine(tempScale, 3, lv_color_hex(0xe74c3c), -8);
    tempMeter->setIndicatorValue(tempNeedle, 25);
    
    auto* tempLabel = new LVLabel(nullptr);
    tempLabel->setText("Temp (°C)")->setPos(820, 340);
    
    // Humidity gauge
    auto* humMeter = new LVMeter(nullptr);
    humMeter->setSize(180, 180)->setPos(980, 360);
    
    lv_meter_scale_t* humScale = humMeter->addScale();
    humMeter->setScaleRange(humScale, 0, 100, 240, 150)
            ->setScaleTicks(humScale, 21, 2, 8, lv_color_hex(0x888888))
            ->setScaleMajorTicks(humScale, 5, 3, 12, lv_color_black(), 8);
    
    lv_meter_indicator_t* humNeedle = humMeter->addNeedleLine(humScale, 3, lv_color_hex(0x3498db), -8);
    humMeter->setIndicatorValue(humNeedle, 65);
    
    auto* humLabel = new LVLabel(nullptr);
    humLabel->setText("Humidity (%)")->setPos(1010, 340);
    
    // Pressure gauge
    auto* pressMeter = new LVMeter(nullptr);
    pressMeter->setSize(180, 180)->setPos(1180, 360);
    
    lv_meter_scale_t* pressScale = pressMeter->addScale();
    pressMeter->setScaleRange(pressScale, 950, 1050, 240, 150)
              ->setScaleTicks(pressScale, 21, 2, 8, lv_color_hex(0x888888))
              ->setScaleMajorTicks(pressScale, 5, 3, 12, lv_color_black(), 8);
    
    lv_meter_indicator_t* pressNeedle = pressMeter->addNeedleLine(pressScale, 3, lv_color_hex(0x2ecc71), -8);
    pressMeter->setIndicatorValue(pressNeedle, 1013);
    
    auto* pressLabel = new LVLabel(nullptr);
    pressLabel->setText("Pressure (hPa)")->setPos(1205, 340);
}

/**
 * ตัวอย่างที่ 7: Simple Table
 * ตารางข้อมูลพื้นฐาน
 */
void example_table_simple(lv_obj_t* parent)
{
    auto* table = new LVTable(nullptr);
    table->setSize(550, 280)->setPos(20, 660);
    
    // Configure table
    table->setRowCount(6)
         ->setColumnCount(4);
    
    // Set column widths
    table->setColumnWidth(0, 100)
         ->setColumnWidth(1, 150)
         ->setColumnWidth(2, 120)
         ->setColumnWidth(3, 150);
    
    // Header row
    table->setCellValue(0, 0, "ID")
         ->setCellValue(0, 1, "Name")
         ->setCellValue(0, 2, "Score")
         ->setCellValue(0, 3, "Status");
    
    // Make header bold
    for (int i = 0; i < 4; i++) {
        table->setCellControl(0, i, LV_TABLE_CELL_CTRL_MERGE_RIGHT);
    }
    
    // Data rows
    table->setCellValue(1, 0, "001")
         ->setCellValue(1, 1, "Alice Johnson")
         ->setCellValue(1, 2, "95")
         ->setCellValue(1, 3, "Pass");
    
    table->setCellValue(2, 0, "002")
         ->setCellValue(2, 1, "Bob Smith")
         ->setCellValue(2, 2, "87")
         ->setCellValue(2, 3, "Pass");
    
    table->setCellValue(3, 0, "003")
         ->setCellValue(3, 1, "Charlie Brown")
         ->setCellValue(3, 2, "72")
         ->setCellValue(3, 3, "Pass");
    
    table->setCellValue(4, 0, "004")
         ->setCellValue(4, 1, "Diana Wilson")
         ->setCellValue(4, 2, "58")
         ->setCellValue(4, 3, "Fail");
    
    table->setCellValue(5, 0, "005")
         ->setCellValue(5, 1, "Eve Martinez")
         ->setCellValue(5, 2, "91")
         ->setCellValue(5, 3, "Pass");
    
    auto* title = new LVLabel(nullptr);
    title->setText("Student Scores")->setPos(240, 640);
}

/**
 * ตัวอย่างที่ 8: Dynamic Table
 * ตารางที่สามารถเพิ่มข้อมูลได้
 */
void example_table_dynamic(lv_obj_t* parent)
{
    auto* table = new LVTable(nullptr);
    table->setSize(550, 280)->setPos(600, 660);
    
    // Initial setup
    table->setRowCount(1)
         ->setColumnCount(3);
    
    table->setColumnWidth(0, 150)
         ->setColumnWidth(1, 200)
         ->setColumnWidth(2, 170);
    
    // Header
    table->setCellValue(0, 0, "Time")
         ->setCellValue(0, 1, "Event")
         ->setCellValue(0, 2, "Value");
    
    // Add log button
    auto* addBtn = new LVButton(nullptr);
    addBtn->setSize(120, 40)
          ->setPos(815, 950)
          ->setLabel("Add Log")
          ->onClick([table]() {
              static int logCount = 0;
              uint32_t rows = table->getRowCount();
              table->setRowCount(rows + 1);
              
              // Add timestamp
              char timeBuf[32];
              snprintf(timeBuf, sizeof(timeBuf), "12:%02d", logCount % 60);
              table->setCellValue(rows, 0, timeBuf);
              
              // Add event
              const char* events[] = {"System Start", "WiFi Connect", "Data Received", "Alert", "User Login"};
              table->setCellValue(rows, 1, events[logCount % 5]);
              
              // Add value
              char valBuf[32];
              snprintf(valBuf, sizeof(valBuf), "%d", (logCount * 10) % 100);
              table->setCellValue(rows, 2, valBuf);
              
              logCount++;
          });
    
    auto* title = new LVLabel(nullptr);
    title->setText("Event Log (Dynamic)")->setPos(780, 640);
}

/**
 * ตัวอย่างที่ 9: Complex Dashboard
 * Dashboard รวม Chart + Meter + Table
 */
void example_complex_data_dashboard(lv_obj_t* parent)
{
    // Top: Line chart
    auto* chart = new LVChart(nullptr);
    chart->setSize(1340, 200)->setPos(20, 1000);
    
    chart->setType(LV_CHART_TYPE_LINE)
         ->setPointCount(24)
         ->setRange(LV_CHART_AXIS_PRIMARY_Y, 0, 100)
         ->setDivLineCount(5, 12);
    
    lv_chart_series_t* series = chart->addSeries(lv_color_hex(0x3498db), LV_CHART_AXIS_PRIMARY_Y);
    
    // 24-hour data
    std::vector<int32_t> hourlyData(24);
    for (int i = 0; i < 24; i++) {
        hourlyData[i] = 30 + (rand() % 40);
    }
    chart->setSeriesPoints(series, hourlyData);
    
    auto* chartTitle = new LVLabel(nullptr);
    chartTitle->setText("24-Hour Activity")->setPos(610, 980);
    
    // Middle: Gauges
    auto* gauge1 = new LVMeter(nullptr);
    gauge1->setSize(150, 150)->setPos(120, 1220);
    
    lv_meter_scale_t* s1 = gauge1->addScale();
    gauge1->setScaleRange(s1, 0, 100, 240, 150)
          ->setScaleTicks(s1, 21, 2, 6, lv_color_hex(0x888888))
          ->setScaleMajorTicks(s1, 5, 3, 10, lv_color_black(), 6);
    
    lv_meter_indicator_t* n1 = gauge1->addNeedleLine(s1, 3, lv_color_hex(0xe74c3c), -6);
    gauge1->setIndicatorValue(n1, 75);
    
    auto* g1Label = new LVLabel(nullptr);
    g1Label->setText("CPU 75%")->setPos(160, 1380);
    
    // Bottom: Status table
    auto* statusTable = new LVTable(nullptr);
    statusTable->setSize(700, 150)->setPos(320, 1220);
    
    statusTable->setRowCount(4)
               ->setColumnCount(3);
    
    statusTable->setColumnWidth(0, 200)
               ->setColumnWidth(1, 200)
               ->setColumnWidth(2, 270);
    
    statusTable->setCellValue(0, 0, "Component")
               ->setCellValue(0, 1, "Status")
               ->setCellValue(0, 2, "Last Update");
    
    statusTable->setCellValue(1, 0, "WiFi")
               ->setCellValue(1, 1, "Connected")
               ->setCellValue(1, 2, "12:45:30");
    
    statusTable->setCellValue(2, 0, "Bluetooth")
               ->setCellValue(2, 1, "Idle")
               ->setCellValue(2, 2, "12:40:15");
    
    statusTable->setCellValue(3, 0, "Storage")
               ->setCellValue(3, 1, "OK (45% used)")
               ->setCellValue(3, 2, "12:45:32");
    
    auto* titleMain = new LVLabel(nullptr);
    titleMain->setText("System Dashboard")->setPos(630, 1190);
}

/**
 * ฟังก์ชันหลักเรียกใช้ตัวอย่างทั้งหมด
 */
void run_data_viz_examples()
{
    example_chart_line(nullptr);
    example_chart_bar(nullptr);
    example_chart_multi_series(nullptr);
    example_chart_live_update(nullptr);
    example_meter_speedometer(nullptr);
    example_meter_dashboard(nullptr);
    example_table_simple(nullptr);
    example_table_dynamic(nullptr);
    example_complex_data_dashboard(nullptr);
}
