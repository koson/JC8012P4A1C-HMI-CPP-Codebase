/**
 * 🚀 Main Function - เรียกตัวอย่างที่ต้องการ
 */
void test_slider_playground()
{
    printf("\n=== LVSlider Playground ===\n");
    
    // เรียกตัวอย่างที่ต้องการทดสอบ
    example_basic_slider();
    example_range_slider();
    example_volume_control();
    example_temperature_slider();
    example_brightness_slider();
    
    // ❓ ลองสร้างของคุณเอง!
    // my_custom_slider();
    
    printf("✅ All sliders created!\n");
    printf("💡 Try moving the sliders on screen\n");
}

/*
 * 📚 สิ่งที่ควรลอง:
 * ==================
 * 1. เปลี่ยนค่า setRange() ดูว่าเกิดอะไรขึ้น
 * 2. ลอง setMode(true) สำหรับ Range Slider
 * 3. ใส่ animation ด้วย setValue(x, true)
 * 4. สร้าง slider ควบคุมสิ่งอื่นๆ (PWM, DAC, etc.)
 * 5. ลองทำ slider แนวตั้ง (หมุน 90 องศา)
 * 
 * 💡 เคล็ดลับ:
 * ============
 * - ใช้ lambda capture [myLabel, mySlider] เพื่อเข้าถึง widget อื่น
 * - printf() ช่วยในการ debug ค่า
 * - ลอง setSymmetric(true) สำหรับ slider แบบสมมาตร
 */
